# ===== Base de datos (Neon/Supabase) =====
# Neon: copia la conexión pooled y la directa desde tu proyecto Neon.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.aws.neon.tech/adonai?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.aws.neon.tech/adonai?sslmode=require"

# ===== Auth.js =====
# Genera una con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== Resend (emails) =====
RESEND_API_KEY=""
# Correo al que reciben los pastores las notificaciones
MAIL_TO_PASTORES="isabelmahechamartinez@gmail.com"

# ===== Google OAuth (login con Google) =====
# Crear en Google Cloud Console: Credentials → "Crear credenciales" → ID de cliente de OAuth
# Tipo: Aplicación web. Orígenes: http://localhost:3000. Redireccionamientos:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Despliegue =====
NEXT_PUBLIC_SITE_URL="https://adonai.ejemplo.com"