# ===== Base de datos (Neon/Supabase) =====
# Neon: copia la conexión pooled y la directa desde tu proyecto Neon.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.aws.neon.tech/adonai?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.aws.neon.tech/adonai?sslmode=require"

# ===== Auth.js =====
# Genera una con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== Resend (emails) =====
RESEND_API_KEY=""
# Correo al que reciben los pastores las notificaciones
MAIL_TO_PASTORES="[PENDIENTE:BRANDA] correo del pastor"

# ===== Despliegue =====
NEXT_PUBLIC_SITE_URL="https://adonai.ejemplo.com"